# Consumer-side generated profile — written by /worktree-calibrate into the TARGET
# repo, never into this plugin repo.
.claude/worktree-profile.json

# Ephemeral and machine-local state from the hygiene plugin used to build this one.
# Not all of it is dot-prefixed: the findings ledger, the generated profile and the
# generated review agents are plain filenames, and the ledger is per-machine review
# history that must not become a committed file in a public plugin repo.
.claude/.hygiene-*
.claude/hygiene-*
.claude/agents/hygiene-*.md
.claude/rules/hygiene-learned-*

.DS_Store
*.swp
*.log
tmp/
.claude/settings.local.json
.claude/worktrees/
